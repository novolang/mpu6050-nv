@test
fn test_the_fifo_count_is_bytes_over_the_bytes_of_a_sample() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // Off: no layout.
    test.assert_eq(mpu6050.fifo_count(d), 0)
    c.regs.insert(0x23, 0x78)
    for i in 0..5
        fifo_both(c, i, 0, 0, 0, 0, 0)
    log_clear(c)
    test.assert_eq(mpu6050.fifo_count(d), 5)
    log_is(c, [2, 0x68, 0x23, 1, -1, 2, 0x68, 0x72, 2, -1])
    // The accelerometer alone: 6 bytes a sample.
    c.regs.insert(0x23, 0x08)
    test.assert_eq(mpu6050.fifo_count(d), 10)
    // A layout the driver does not read is no samples: another set of
    // gyroscope axes, the temperature, an external sensor.
    c.regs.insert(0x23, 0x18)
    test.assert_eq(mpu6050.fifo_count(d), 0)
    c.regs.insert(0x23, 0x88)
    test.assert_eq(mpu6050.fifo_count(d), 0)
    c.regs.insert(0x23, 0x09)
    test.assert_eq(mpu6050.fifo_count(d), 0)
    c.regs.insert(0x23, 0x70)
    test.assert_eq(mpu6050.fifo_count(d), 0)
    c.st.insert(4, 0)
    test.assert_eq(mpu6050.fifo_count(d), 0)
    let e = chip()
    e.regs.insert(0x23, 0x78)
    test.assert_eq(mpu6050.fifo_count(flaky_read(e, 0x72, 1)), 0)

@test
fn test_the_fifo_is_reset_with_fifo_en_clear_then_configured_then_enabled() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    fifo_both(c, 1, 2, 3, 4, 5, 6)
    log_clear(c)
    test.assert(mpu6050.fifo_start(d, true))
    test.assert_eq(reg_of(c, 0x23), 0x78)
    test.assert_eq(reg_of(c, 0x6A), 0x40)
    test.assert_eq(fifo_left(c), 0)
    let seen = written(c)
    // USER_CTRL cleared, FIFO_RESET, FIFO_EN, USER_CTRL enabled.
    test.assert_eq(seen.len(), 4)
    test.assert_eq(seen[0], 0x6A)
    test.assert_eq(seen[1], 0x6A)
    test.assert_eq(seen[2], 0x23)
    test.assert_eq(seen[3], 0x6A)
    test.assert(mpu6050.fifo_start(d, false))
    test.assert_eq(reg_of(c, 0x23), 0x08)

@test
fn test_the_trait_configures_the_fifo_in_stream_mode_with_the_gyroscope_that_runs() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // The gyroscope runs: the sample is 12 bytes.
    test.assert(mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoStream, 8))
    test.assert_eq(reg_of(c, 0x23), 0x78)
    test.assert_eq(reg_of(c, 0x6A), 0x40)
    // The gyroscope's axes in standby: the accelerometer alone.
    c.regs.insert(0x6C, 0x07)
    test.assert(mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoStream, 32))
    test.assert_eq(reg_of(c, 0x23), 0x08)
    // Off empties the FIFO and clears its layout.
    test.assert(mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoOff, 0))
    test.assert_eq(reg_of(c, 0x23), 0x00)
    test.assert_eq(reg_of(c, 0x6A), 0x00)
    // The part has no stop-on-full mode, and a watermark of 1 to 32 only.
    log_clear(c)
    test.assert(not mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoStop, 8))
    test.assert(not mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoStream, 0))
    test.assert(not mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoStream, 33))
    log_is(c, [])
    // A part that does not answer takes nothing.
    c.st.insert(4, 0)
    test.assert(not mpu6050.fifo_configure(d, AccelFifoMode.AccelFifoStream, 8))

@test
fn test_a_fifo_start_that_a_register_refuses_fails() [io, hw]
    let regs = [0x6A, 0x6A, 0x23, 0x6A]
    let nth = [1, 2, 1, 3]
    for i in 0..regs.len()
        let f = flaky_write(chip(), regs[i], nth[i])
        test.assert(not mpu6050.fifo_start(f, true))

@test
fn test_the_fifo_is_stopped_emptied_and_its_layout_cleared() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(mpu6050.fifo_start(d, true))
    fifo_both(c, 1, 2, 3, 4, 5, 6)
    test.assert(mpu6050.fifo_stop(d))
    test.assert_eq(reg_of(c, 0x6A), 0x00)
    test.assert_eq(reg_of(c, 0x23), 0x00)
    test.assert_eq(fifo_left(c), 0)
    let regs = [0x6A, 0x23, 0x6A]
    let nth = [1, 1, 2]
    for i in 0..regs.len()
        test.assert(not mpu6050.fifo_stop(flaky_write(chip(), regs[i], nth[i])))

@test
fn test_the_fifo_is_read_a_sample_at_a_time_from_the_port() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(mpu6050.fifo_start(d, true))
    // ±2 g and ±250 dps after a reset.
    fifo_both(c, 16384, -8192, 4096, 131, -131, 0)
    fifo_both(c, 8192, 0, 0, 262, 0, 0)
    log_clear(c)
    var a: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(mpu6050.fifo_read(d, var a), 2)
    log_is(c, [2, 0x68, 0x23, 1, -1, 2, 0x68, 0x72, 2, -1, 2, 0x68, 0x1C, 1, -1,
        2, 0x68, 0x74, 12, -1, 2, 0x68, 0x74, 12, -1])
    test.assert_eq(a.len(), 2)
    test.assert_eq(a[0].x, 1000)
    test.assert_eq(a[0].y, -500)
    test.assert_eq(a[0].z, 250)
    test.assert_eq(a[1].x, 500)
    test.assert_eq(mpu6050.fifo_count(d), 0)

@test
fn test_both_sensors_samples_come_out_of_one_sample_each() [io, hw]
    let c = chip()

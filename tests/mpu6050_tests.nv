// mpu6050_tests — the driver over a double of the part: a register file
// that answers on an I2C bus the way TDK InvenSense's register map
// (RM-MPU-6000A-00 revision 4.0) and product specification
// (PS-MPU-6000A-00 revision 3.4) say an MPU-6050 does, so the big-endian
// counts, every conversion, the sample rate and its filter, the power
// modes, the FIFO and its overflow, the self-tests with the factory trims
// and the bring-up are checked on the host, one transaction at a time.  The
// log keeps what the controller sent, in a form the tests compare.
//
// Log entries: an I2C write is 1, the address, the bytes sent, -1; an I2C
// read is 2, the address, the register, the count, -1.

use std.test
use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, AccelFifoMode, Accelerometer }
use dev_gyro.{ GyroMilliDps, GyroRange, Gyroscope }
use dev_imu.{ ImuSample, Imu, ImuControl }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }
use mpu6050
use mpu6050.{ Mpu6050, Mpu6050Mode, Mpu6050Port }

// ── The double ───────────────────────────────────────────────────────
//
// `regs` is the part's registers, keyed by address.  `st` is the double's
// state: 4 is 1 when a part is there, 10 the bytes taken out of the FIFO,
// 11 the count latched by FIFO_COUNTH, 22 the I2C clock, 30 to 32 the counts
// the accelerometer's self-test adds to X, Y and Z, 33 to 35 the
// gyroscope's, 41 INT_STATUS, 43 1 to set DATA_RDY_INT on every read of it,
// 44 and 45 the grants of that when 45 is 1, 50 the microseconds waited, 51
// the waits, 60 the reads of PWR_MGMT_1 that still show DEVICE_RESET, 66 the
// number of them after a reset, 67 1 to keep no log, 70 the I2C address, 98
// the bytes in the FIFO, 99 the entries in the log and 100 a WHO_AM_I that
// a reset keeps.  `ro` lists registers that ignore a write.  `fifo` holds
// the FIFO's bytes and `log` the log.

struct Chip
    regs: HashMap<Int, Int>
    st: HashMap<Int, Int>
    ro: HashMap<Int, Int>
    log: HashMap<Int, Int>
    fifo: HashMap<Int, Int>

@tier(app)
fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

// The registers as a reset leaves them (RM § 3): 0 but PWR_MGMT_1 at 0x40
// and WHO_AM_I at 0x68.
@tier(app)
fn defaults(c: Chip)
    for r in 0..128
        c.regs.insert(r, 0)
    c.regs.insert(0x6B, 0x40)
    c.regs.insert(0x75, 0x68)

// The chip with its reset values in place.
@tier(app)
fn chip() -> Chip
    let c = Chip { regs: HashMap.new(),
        st: HashMap.new(),
        ro: HashMap.new(),
        log: HashMap.new(),
        fifo: HashMap.new() }
    defaults(c)
    c.st.insert(4, 1)
    c.st.insert(66, 2)
    c.st.insert(70, 0x68)
    c

// Appends a value to the log, unless the test keeps none.
@tier(app)
fn log_push(c: Chip, v: Int)
    if at(c.st, 67) == 1
        return
    let n = at(c.st, 99)
    c.log.insert(n, v)
    c.st.insert(99, n + 1)

// Empties the log.
@tier(app)
fn log_clear(c: Chip)
    c.st.insert(99, 0)

// The FIFO is on when USER_CTRL says so.
@tier(app)
fn fifo_on(c: Chip) -> Bool
    (at(c.regs, 0x6A) & 0x40) != 0

// The bytes in the FIFO.
@tier(app)
fn fifo_left(c: Chip) -> Int
    at(c.st, 98) - at(c.st, 10)

// The self-test's push for an axis of a sensor whose configuration register
// is `cfg` (bit 7 X, 6 Y, 5 Z), counts in `base` plus the axis.
@tier(app)
fn st_push(c: Chip, cfg: Int, axis: Int, base: Int) -> Int
    if (cfg & (0x80 >> axis)) != 0
        return at(c.st, base + axis)
    0

// A data register 0x3B to 0x48: the stored count plus the self-test's push,
// one byte of it, high byte first.
@tier(app)
fn out_read(c: Chip, reg: Int) -> Int
    let lo = 0x3B + (reg - 0x3B) / 2 * 2
    var v = at(c.regs, lo) * 256 + at(c.regs, lo + 1)
    if v >= 32768
        v = v - 65536
    if reg < 0x41
        v = v + st_push(c, at(c.regs, 0x1C), (reg - 0x3B) / 2, 30)
    elif reg >= 0x43
        v = v + st_push(c, at(c.regs, 0x1B), (reg - 0x43) / 2, 33)
    let u = v & 0xFFFF
    if (reg - 0x3B) % 2 == 0
        return (u >> 8) & 0xFF
    u & 0xFF

// INT_STATUS as the part answers it; the flags clear on the read.
@tier(app)
fn status_read(c: Chip) -> Int
    var v = at(c.st, 41)
    c.st.insert(41, 0)
    if at(c.st, 43) == 1
        if at(c.st, 45) == 0
            v = v | 0x01
        elif at(c.st, 44) > 0
            c.st.insert(44, at(c.st, 44) - 1)
            v = v | 0x01
    v

// A register as the part answers it.
@tier(app)
fn chip_read(c: Chip, reg: Int) -> Int
    if reg == 0x3A
        return status_read(c)
    if reg == 0x6B and at(c.st, 60) > 0
        c.st.insert(60, at(c.st, 60) - 1)
        return 0x80
    if reg == 0x72
        let n = fifo_left(c)
        c.st.insert(11, n)
        return (n >> 8) & 0xFF
    if reg == 0x73
        return at(c.st, 11) & 0xFF
    if reg == 0x74
        if at(c.st, 10) >= at(c.st, 98)
            return 0
        let v = at(c.fifo, at(c.st, 10))
        c.st.insert(10, at(c.st, 10) + 1)
        return v
    if reg >= 0x3B and reg <= 0x48
        return out_read(c, reg)
    at(c.regs, reg)

// A write to a register, which a read-only one ignores.  The device reset
// puts the registers back to their defaults and shows DEVICE_RESET for the
// reads in key 66; FIFO_RESET empties the FIFO while FIFO_EN is clear and
// clears itself.
@tier(app)
fn chip_write(c: Chip, reg: Int, v: Int)
    if at(c.ro, reg) == 1
        return
    if reg == 0x6B and (v & 0x80) != 0
        defaults(c)
        if at(c.st, 100) != 0
            c.regs.insert(0x75, at(c.st, 100))
        c.st.insert(60, at(c.st, 66))
        c.st.insert(10, at(c.st, 98))
        return
    if reg == 0x6A
        if (v & 0x04) != 0 and (v & 0x40) == 0
            c.st.insert(10, at(c.st, 98))
        c.regs.insert(reg, v & 0xFB)
        return
    c.regs.insert(reg, v & 0xFF)

struct FakeI2c
    c: Chip

impl I2cBus for FakeI2c
    @tier(app)
    fn init(self, freq: Int) [hw]
        self.c.st.insert(22, freq)

    @tier(app)
    fn write(self, addr: Int, data: [u8]) -> Bool [hw]
        log_push(self.c, 1)
        log_push(self.c, addr)
        for b in data
            log_push(self.c, b as Int)
        log_push(self.c, -1)
        if addr != at(self.c.st, 70) or at(self.c.st, 4) == 0 or data.len() < 2
            return false
        var r = data[0] as Int
        for i in 1..data.len()
            chip_write(self.c, r, data[i] as Int)
            r = r + inc_of(r)
        true

    @tier(app)
    fn read(self, addr: Int, n: Int) -> ?[u8] [hw]
        None

    @tier(app)
    fn write_read(self, addr: Int, tx: [u8], n: Int) -> ?[u8] [hw]
        log_push(self.c, 2)
        log_push(self.c, addr)
        log_push(self.c, tx[0] as Int)
        log_push(self.c, n)
        log_push(self.c, -1)
        if addr != at(self.c.st, 70) or at(self.c.st, 4) == 0
            return None
        var r = tx[0] as Int
        var out: [u8] = []
        for _i in 0..n
            list.push(out, chip_read(self.c, r) as u8)
            r = r + inc_of(r)
        Some(out)

// Whether a register advances the address in a multiple-byte transfer: all
// do but the FIFO port.
@tier(app)
fn inc_of(reg: Int) -> Int
    if reg == 0x74
        return 0
    1

// The GPIO double.
struct FakePins
    c: Chip
    levels: HashMap<Int, Int>
    modes: HashMap<Int, Int>

impl GpioOut for FakePins
    @tier(app)
    fn mode(self, pin: Int, dir: Int) [hw]
        self.modes.insert(pin, dir)

    @tier(app)
    fn set(self, pin: Int, val: Int) [hw]
        self.levels.insert(pin, val)

    @tier(app)
    fn get(self, pin: Int) -> Int [hw]
        at(self.levels, pin)

@tier(app)
fn pins(c: Chip) -> FakePins
    FakePins { c: c, levels: HashMap.new(), modes: HashMap.new() }

// Counts a wait.
@tier(app)
fn waited(c: Chip, us: Int)
    c.st.insert(50, at(c.st, 50) + us)
    c.st.insert(51, at(c.st, 51) + 1)

// The port, as a type that holds a bus implements it: every method is the
// package's own function over the double.
struct I2cDut
    bus: FakeI2c
    pins: FakePins
    w: DeviceWiring

impl Mpu6050Port for I2cDut
    @tier(app)
    fn setup(self) -> Bool [hw]
        mpu6050.i2c_setup(self.bus, self.pins, self.w)

    @tier(app)
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        mpu6050.i2c_read_into(self.bus, self.w, reg, n, var dst)

    @tier(app)
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        mpu6050.i2c_write(self.bus, self.w, reg, v)

    @tier(app)
    fn irq_level(self) -> Int [hw]
        mpu6050.irq_level_of(self.pins, self.w)

    @tier(app)
    fn wait_us(self, us: Int) [hw]
        waited(self.bus.c, us)

// A port that refuses one chosen write or one chosen read of a chosen
// register: `fail` maps a register to the number of the write, counted from
// 1, that the bus refuses, and `seen` counts the writes; `rfail` and
// `rseen` do the same for reads.  `quiet` limits the reads of FIFO_R_W to
// the number in key 0 once key 1 is 1.
struct Flaky
    inner: I2cDut
    fail: HashMap<Int, Int>
    seen: HashMap<Int, Int>
    rfail: HashMap<Int, Int>
    rseen: HashMap<Int, Int>
    quiet: HashMap<Int, Int>

impl Mpu6050Port for Flaky
    @tier(app)
    fn setup(self) -> Bool [hw]
        self.inner.setup()

    @tier(app)
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        let k = at(self.rseen, reg) + 1
        self.rseen.insert(reg, k)
        if at(self.rfail, reg) == k
            dst.clear()
            return false
        if reg == 0x74 and at(self.quiet, 1) == 1
            if at(self.quiet, 0) == 0
                dst.clear()
                return false
            self.quiet.insert(0, at(self.quiet, 0) - 1)
        self.inner.read_regs(reg, n, var dst)

    @tier(app)
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        let n = at(self.seen, reg) + 1
        self.seen.insert(reg, n)
        if at(self.fail, reg) == n
            return false
        self.inner.write_reg(reg, v)

    @tier(app)
    fn irq_level(self) -> Int [hw]
        self.inner.irq_level()

    @tier(app)
    fn wait_us(self, us: Int) [hw]
        self.inner.wait_us(us)

@tier(app)
fn flaky(c: Chip) -> Flaky
    Flaky { inner: i2c_dut(c),
        fail: HashMap.new(),
        seen: HashMap.new(),
        rfail: HashMap.new(),
        rseen: HashMap.new(),
        quiet: HashMap.new() }

@tier(app)
fn flaky_write(c: Chip, reg: Int, nth: Int) -> Flaky
    let f = flaky(c)
    f.fail.insert(reg, nth)
    f

@tier(app)
fn flaky_read(c: Chip, reg: Int, nth: Int) -> Flaky
    let f = flaky(c)
    f.rfail.insert(reg, nth)
    f

// The board's wiring: the part at 0x68 on I2C, INT on pin 65.
@tier(app)
fn i2c_wiring() -> DeviceWiring
    dev_bus.wiring_irq(dev_bus.wiring_i2c(0, 0x68), 65)

@tier(app)
fn i2c_dut(c: Chip) -> I2cDut
    I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: i2c_wiring() }

// Asserts the log holds exactly `want`, then empties it.
@tier(app)
fn log_is(c: Chip, want: [Int])
    test.assert_eq(at(c.st, 99), want.len())
    for i in 0..want.len()
        test.assert_eq(at(c.log, i), want[i])
    log_clear(c)

@tier(app)
fn reg_of(c: Chip, r: Int) -> Int
    at(c.regs, r)

// The registers written, in order, from a log of I2C transactions.
@tier(app)
fn written(c: Chip) -> [Int]
    var out: [Int] = []
    var i = 0
    while i < at(c.st, 99)
        let kind = at(c.log, i)
        if kind == 1
            list.push(out, at(c.log, i + 2))
        i = i + 1
        while i < at(c.st, 99) and at(c.log, i - 1) != -1
            i = i + 1
    out

// Sets the 16-bit count of an axis, high byte first, at `reg`.
@tier(app)
fn put16(c: Chip, reg: Int, v: Int)
    let u = v & 0xFFFF
    c.regs.insert(reg, u >> 8)
    c.regs.insert(reg + 1, u & 0xFF)

// Sets the accelerometer's three axes (0x3B), then the gyroscope's (0x43).
@tier(app)
fn put_accel(c: Chip, x: Int, y: Int, z: Int)
    put16(c, 0x3B, x)
    put16(c, 0x3D, y)
    put16(c, 0x3F, z)

@tier(app)
fn put_gyro(c: Chip, x: Int, y: Int, z: Int)
    put16(c, 0x43, x)
    put16(c, 0x45, y)
    put16(c, 0x47, z)

// Appends a byte to the FIFO.
@tier(app)
fn fifo_byte(c: Chip, v: Int)
    let n = at(c.st, 98)
    c.fifo.insert(n, v & 0xFF)
    c.st.insert(98, n + 1)

@tier(app)
fn fifo_s16(c: Chip, v: Int)
    let u = v & 0xFFFF
    fifo_byte(c, u >> 8)
    fifo_byte(c, u & 0xFF)

// Appends a sample of 12 bytes: the accelerometer's three counts, then the
// gyroscope's.
@tier(app)
fn fifo_both(c: Chip, ax: Int, ay: Int, az: Int, gx: Int, gy: Int, gz: Int)
    for v in [ax, ay, az, gx, gy, gz]
        fifo_s16(c, v)

// Appends a sample of the accelerometer alone, 6 bytes.
@tier(app)
fn fifo_accel(c: Chip, x: Int, y: Int, z: Int)
    for v in [x, y, z]
        fifo_s16(c, v)

@tier(app)
fn x_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.x
        None    => -99999

@tier(app)
fn y_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.y
        None    => -99999

@tier(app)
fn z_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.z
        None    => -99999

@tier(app)
fn gx_of(o: ?GyroMilliDps) -> Int
    match o
        Some(g) => g.x
        None    => -99999

@tier(app)
fn gy_of(o: ?GyroMilliDps) -> Int
    match o
        Some(g) => g.y
        None    => -99999

@tier(app)
fn gz_of(o: ?GyroMilliDps) -> Int
    match o
        Some(g) => g.z
        None    => -99999

// ── The bus framing ──────────────────────────────────────────────────

@test
fn test_an_i2c_read_is_the_register_and_a_repeated_start_for_any_count() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(mpu6050.reg_read(d, 0x75) ?? -1, 0x68)
    log_is(c, [2, 0x68, 0x75, 1, -1])
    c.regs.insert(0x20, 11)
    c.regs.insert(0x21, 22)
    var b: DevBytes = Vec.new()
    test.assert(d.read_regs(0x20, 2, var b))
    log_is(c, [2, 0x68, 0x20, 2, -1])
    test.assert_eq(b[0] as Int, 11)
    test.assert_eq(b[1] as Int, 22)

@test
fn test_an_i2c_write_is_the_register_then_the_byte() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(d.write_reg(0x1B, 0x08))
    log_is(c, [1, 0x68, 0x1B, 0x08, -1])
    test.assert_eq(reg_of(c, 0x1B), 0x08)

@test
fn test_a_missing_part_does_not_answer() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(mpu6050.reg_read(d, 0x75) == None)
    test.assert(not d.write_reg(0x1B, 1))
    test.assert(not mpu6050.reg_write(d, 0x1B, 1))
    test.assert(not mpu6050.reg_update(d, 0x1B, 1, 1))
    test.assert(mpu6050.id_read(d) == None)

@test
fn test_a_wiring_with_no_address_is_not_an_i2c_part() [io, hw]
    let c = chip()
    let d = I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: dev_bus.wiring_spi(0, 67) }
    test.assert(not d.setup())
    var b: DevBytes = Vec.new()
    test.assert(not d.read_regs(0x75, 1, var b))
    test.assert(not d.write_reg(0x1B, 1))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_the_fifo_port_does_not_advance_the_address_and_the_others_do() [io, hw]
    // A burst from FIFO_R_W reads the port again and again; a burst from a
    // data register walks on.
    let c = chip()
    c.regs.insert(0x6A, 0x40)
    fifo_accel(c, 1, 2, 3)
    var b: DevBytes = Vec.new()
    test.assert(i2c_dut(c).read_regs(0x74, 4, var b))
    test.assert_eq(b[0] as Int, 0)
    test.assert_eq(b[1] as Int, 1)
    test.assert_eq(b[2] as Int, 0)
    test.assert_eq(b[3] as Int, 2)
    c.regs.insert(0x20, 5)
    c.regs.insert(0x21, 6)
    test.assert(i2c_dut(c).read_regs(0x20, 2, var b))
    test.assert_eq(b[1] as Int, 6)

// ── Setup ────────────────────────────────────────────────────────────

@test
fn test_setup_makes_the_interrupt_pin_an_input_and_the_bus_fast() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(d.setup())
    test.assert_eq(at(c.st, 22), 400000)
    test.assert_eq(at(d.pins.modes, 65), 0)

@test
fn test_the_interrupt_line_level() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    d.pins.levels.insert(65, 1)
    test.assert_eq(d.irq_level(), 1)
    test.assert_eq(mpu6050.irq_level_of(d.pins, dev_bus.wiring_i2c(0, 0x68)), -1)

@test
fn test_a_wait_reaches_the_port() [io, hw]
    let c = chip()
    i2c_dut(c).wait_us(250)
    i2c_dut(c).wait_us(50)
    test.assert_eq(at(c.st, 50), 300)
    test.assert_eq(at(c.st, 51), 2)

// ── Identity ─────────────────────────────────────────────────────────

@test
fn test_the_identity_is_who_am_i_and_other_parts_are_other_values() [io, hw]
    let c = chip()
    match mpu6050.id_read(i2c_dut(c))
        Some(id) =>
            test.assert_eq(id.who, 0x68)
            test.assert(id.rev == None)
        None     => test.assert(false)
    // A bus held high or low is no part.
    c.regs.insert(0x75, 0xFF)
    test.assert(mpu6050.id_read(i2c_dut(c)) == None)
    c.regs.insert(0x75, 0)
    test.assert(mpu6050.id_read(i2c_dut(c)) == None)

// ── Ranges and steps ─────────────────────────────────────────────────

@test
fn test_the_range_codes_run_from_the_narrowest_up() [io, hw]
    test.assert(mpu6050.accel_range_of(0x00) == AccelRange2g)
    test.assert(mpu6050.accel_range_of(0x08) == AccelRange4g)
    test.assert(mpu6050.accel_range_of(0x10) == AccelRange8g)
    test.assert(mpu6050.accel_range_of(0x18) == AccelRange16g)
    // The self-test bits do not matter.
    test.assert(mpu6050.accel_range_of(0xE8) == AccelRange4g)
    test.assert_eq(mpu6050.accel_fs_of(AccelRange2g), 0)
    test.assert_eq(mpu6050.accel_fs_of(AccelRange4g), 1)
    test.assert_eq(mpu6050.accel_fs_of(AccelRange8g), 2)
    test.assert_eq(mpu6050.accel_fs_of(AccelRange16g), 3)
    test.assert(mpu6050.gyro_range_of(0x00) == GyroRange250dps)
    test.assert(mpu6050.gyro_range_of(0x08) == GyroRange500dps)
    test.assert(mpu6050.gyro_range_of(0x10) == GyroRange1000dps)
    test.assert(mpu6050.gyro_range_of(0x18) == GyroRange2000dps)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange250dps), 0)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange500dps), 1)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange1000dps), 2)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange2000dps), 3)
    // The five ranges the part does not have.
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange15dps), -1)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange31dps), -1)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange62dps), -1)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange125dps), -1)
    test.assert_eq(mpu6050.gyro_fs_of(GyroRange4000dps), -1)

@test
fn test_the_sensitivities_are_the_product_specifications() [io, hw]
    test.assert_eq(mpu6050.lsb_per_g(0x00), 16384)
    test.assert_eq(mpu6050.lsb_per_g(0x08), 8192)
    test.assert_eq(mpu6050.lsb_per_g(0x10), 4096)
    test.assert_eq(mpu6050.lsb_per_g(0x18), 2048)
    test.assert_eq(mpu6050.tenth_lsb_per_dps(0x00), 1310)
    test.assert_eq(mpu6050.tenth_lsb_per_dps(0x08), 655)
    test.assert_eq(mpu6050.tenth_lsb_per_dps(0x10), 328)
    test.assert_eq(mpu6050.tenth_lsb_per_dps(0x18), 164)

// ── Samples ──────────────────────────────────────────────────────────

@test
fn test_an_acceleration_is_converted_at_each_range() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // ±2 g after a reset: 16,384 counts a g.
    put_accel(c, 16384, -8192, 1)
    test.assert_eq(x_of(mpu6050.accel_read_of(d)), 1000)
    test.assert_eq(y_of(mpu6050.accel_read_of(d)), -500)
    test.assert_eq(z_of(mpu6050.accel_read_of(d)), 0)
    c.regs.insert(0x1C, 0x08)
    test.assert_eq(x_of(mpu6050.accel_read_of(d)), 2000)
    c.regs.insert(0x1C, 0x10)
    test.assert_eq(x_of(mpu6050.accel_read_of(d)), 4000)
    c.regs.insert(0x1C, 0x18)
    test.assert_eq(x_of(mpu6050.accel_read_of(d)), 8000)
    put_accel(c, 32767, -32768, 0)
    test.assert_eq(x_of(mpu6050.accel_read_of(d)), 15999)
    test.assert_eq(y_of(mpu6050.accel_read_of(d)), -16000)

@test
fn test_a_rate_of_turn_is_converted_at_each_range() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // ±250 dps after a reset: 131 counts a degree per second.
    put_gyro(c, 131, -262, 1)
    test.assert_eq(gx_of(mpu6050.gyro_read_of(d)), 1000)
    test.assert_eq(gy_of(mpu6050.gyro_read_of(d)), -2000)
    test.assert_eq(gz_of(mpu6050.gyro_read_of(d)), 7)
    c.regs.insert(0x1B, 0x08)
    put_gyro(c, 655, 0, 0)
    test.assert_eq(gx_of(mpu6050.gyro_read_of(d)), 10000)
    c.regs.insert(0x1B, 0x10)
    put_gyro(c, 328, 0, 0)
    test.assert_eq(gx_of(mpu6050.gyro_read_of(d)), 10000)
    c.regs.insert(0x1B, 0x18)
    put_gyro(c, 164, 0, 0)
    test.assert_eq(gx_of(mpu6050.gyro_read_of(d)), 10000)

@test
fn test_each_sample_is_the_ranges_then_one_burst_of_the_outputs() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    log_clear(c)
    let _a = mpu6050.accel_read_of(d)
    log_is(c, [2, 0x68, 0x1B, 2, -1, 2, 0x68, 0x3B, 6, -1])
    let _g = mpu6050.gyro_read_of(d)
    log_is(c, [2, 0x68, 0x1B, 2, -1, 2, 0x68, 0x43, 6, -1])
    let _i = mpu6050.imu_read_of(d)
    log_is(c, [2, 0x68, 0x1B, 2, -1, 2, 0x68, 0x3B, 14, -1])
    let _t = mpu6050.temp_read_of(d)
    log_is(c, [2, 0x68, 0x41, 2, -1])

@test
fn test_a_paired_sample_has_both_from_one_burst_at_their_own_ranges() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put_accel(c, 8192, 0, 4096)
    put_gyro(c, 655, -655, 0)
    // The accelerometer at ±4 g and the gyroscope at ±500 dps.
    c.regs.insert(0x1C, 0x08)
    c.regs.insert(0x1B, 0x08)
    match mpu6050.imu_read_of(d)
        Some(s) =>
            test.assert_eq(s.accel.x, 1000)
            test.assert_eq(s.accel.z, 500)
            test.assert_eq(s.gyro.x, 10000)
            test.assert_eq(s.gyro.y, -10000)
        None    => test.assert(false)

@test
fn test_a_paired_sample_carries_the_die_temperature_of_the_same_burst() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put_accel(c, 8192, 0, 4096)
    put_gyro(c, 131, -131, 0)
    put16(c, 0x41, 340)
    c.regs.insert(0x1C, 0x08)
    log_clear(c)
    match mpu6050.imu_read_temp_of(d)
        Some(s) =>
            test.assert_eq(s.accel.x, 1000)
            test.assert_eq(s.accel.z, 500)
            test.assert_eq(s.gyro.x, 1000)
            test.assert_eq(s.gyro.y, -1000)
            test.assert_eq(s.temp.milli_c, 37530)
        None    => test.assert(false)
    // The same two transactions as the paired sample without the temperature.
    log_is(c, [2, 0x68, 0x1B, 2, -1, 2, 0x68, 0x3B, 14, -1])
    c.st.insert(4, 0)
    test.assert(mpu6050.imu_read_temp_of(d) == None)
    let e = chip()
    test.assert(mpu6050.imu_read_temp_of(flaky_read(e, 0x3B, 1)) == None)

@test
fn test_no_part_gives_no_sample_and_is_never_ready() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(mpu6050.accel_read_of(d) == None)
    test.assert(mpu6050.gyro_read_of(d) == None)
    test.assert(mpu6050.imu_read_of(d) == None)
    test.assert(not mpu6050.data_ready_of(d))
    test.assert(mpu6050.int_status(d) == None)
    test.assert(mpu6050.temp_read_of(d) == None)
    // A part that answers the ranges and then goes quiet.
    let e = chip()
    test.assert(mpu6050.accel_read_of(flaky_read(e, 0x3B, 1)) == None)
    test.assert(mpu6050.gyro_read_of(flaky_read(e, 0x43, 1)) == None)
    test.assert(mpu6050.imu_read_of(flaky_read(e, 0x3B, 1)) == None)

@test
fn test_ready_is_data_rdy_int_and_reading_it_clears_it() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(not mpu6050.data_ready_of(d))
    c.st.insert(41, 0x01)
    test.assert(mpu6050.data_ready_of(d))
    // The read cleared it: the second of two calls answers false.
    test.assert(not mpu6050.data_ready_of(d))
    c.st.insert(41, 0x11)
    test.assert_eq(mpu6050.int_status(d) ?? -1, 0x11)
    test.assert_eq(mpu6050.int_status(d) ?? -1, 0)

@test
fn test_the_temperature_is_340_counts_a_degree_from_36_53_degrees() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(mpu6050.temp_read_of(d) == Some(TempMilliC { milli_c: 36530 }))
    put16(c, 0x41, 340)
    test.assert(mpu6050.temp_read_of(d) == Some(TempMilliC { milli_c: 37530 }))
    put16(c, 0x41, -340)
    test.assert(mpu6050.temp_read_of(d) == Some(TempMilliC { milli_c: 35530 }))
    // The product specification's offset: -521 counts at 35 degrees.
    put16(c, 0x41, -521)
    test.assert(mpu6050.temp_read_of(d) == Some(TempMilliC { milli_c: 34998 }))
    put16(c, 0x41, 1)
    test.assert(mpu6050.temp_read_of(d) == Some(TempMilliC { milli_c: 36532 }))

// ── Range, filter and rate ───────────────────────────────────────────

@test
fn test_a_range_is_changed_without_touching_the_self_test_bits() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x1C, 0xE0)
    test.assert(mpu6050.accel_range_write(d, AccelRange8g))
    test.assert_eq(reg_of(c, 0x1C), 0xF0)
    test.assert(mpu6050.accel_range_read(d) == AccelRange8g)
    c.regs.insert(0x1B, 0x40)
    test.assert(mpu6050.gyro_range_write(d, GyroRange1000dps))
    test.assert_eq(reg_of(c, 0x1B), 0x50)
    test.assert(mpu6050.gyro_range_read(d) == GyroRange1000dps)
    // A range the part does not have is refused and the register stays.
    test.assert(not mpu6050.gyro_range_write(d, GyroRange125dps))
    test.assert(not mpu6050.gyro_range_write(d, GyroRange4000dps))
    test.assert_eq(reg_of(c, 0x1B), 0x50)
    c.st.insert(4, 0)
    test.assert(not mpu6050.accel_range_write(d, AccelRange4g))
    test.assert(not mpu6050.gyro_range_write(d, GyroRange500dps))
    test.assert(mpu6050.accel_range_read(d) == AccelRange2g)
    test.assert(mpu6050.gyro_range_read(d) == GyroRange250dps)

@test
fn test_the_filter_is_set_to_0_to_6_and_leaves_the_frame_sync_bits() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x1A, 0x10)
    test.assert(mpu6050.dlpf_write(d, 3))
    test.assert_eq(reg_of(c, 0x1A), 0x13)
    test.assert_eq(mpu6050.dlpf_read(d), 3)
    test.assert(mpu6050.dlpf_write(d, 0))
    test.assert(mpu6050.dlpf_write(d, 6))
    test.assert(not mpu6050.dlpf_write(d, 7))
    test.assert(not mpu6050.dlpf_write(d, -1))
    test.assert_eq(mpu6050.dlpf_read(d), 6)
    c.st.insert(4, 0)
    test.assert_eq(mpu6050.dlpf_read(d), -1)
    test.assert(not mpu6050.dlpf_write(d, 2))

@test
fn test_the_output_rate_is_8_khz_with_the_filter_off_and_1_khz_with_it_on() [io, hw]
    test.assert_eq(mpu6050.base_mhz_of(0), 8000000)
    test.assert_eq(mpu6050.base_mhz_of(7), 8000000)
    test.assert_eq(mpu6050.base_mhz_of(1), 1000000)
    test.assert_eq(mpu6050.base_mhz_of(6), 1000000)
    // The frame sync bits do not matter.
    test.assert_eq(mpu6050.base_mhz_of(0x38), 8000000)
    test.assert_eq(mpu6050.base_mhz_of(0x39), 1000000)

@test
fn test_the_sample_rate_is_the_output_rate_over_one_plus_the_divider() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // After a reset the filter is off and the divider 0: 8 kHz.
    test.assert_eq(mpu6050.rate_read(d), 8000000)
    c.regs.insert(0x19, 7)
    test.assert_eq(mpu6050.rate_read(d), 1000000)
    c.regs.insert(0x1A, 3)
    c.regs.insert(0x19, 9)
    log_clear(c)
    test.assert_eq(mpu6050.rate_read(d), 100000)
    log_is(c, [2, 0x68, 0x1A, 1, -1, 2, 0x68, 0x19, 1, -1])
    c.regs.insert(0x19, 255)
    test.assert_eq(mpu6050.rate_read(d), 3906)
    c.st.insert(4, 0)
    test.assert_eq(mpu6050.rate_read(d), -1)
    let e = chip()
    test.assert_eq(mpu6050.rate_read(flaky_read(e, 0x19, 1)), -1)

@test
fn test_a_requested_rate_rounds_up_to_one_the_divider_gives() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x1A, 3)
    test.assert_eq(mpu6050.rate_write(d, 100000), 100000)
    test.assert_eq(reg_of(c, 0x19), 9)
    // 150 Hz: the slowest rate at or above it is 166.7 Hz (divider 5).
    test.assert_eq(mpu6050.rate_write(d, 150000), 166666)
    test.assert_eq(reg_of(c, 0x19), 5)
    // The fastest is the output rate, whatever is asked.
    test.assert_eq(mpu6050.rate_write(d, 5000000), 1000000)
    test.assert_eq(reg_of(c, 0x19), 0)
    // The slowest is 1/256 of it, for a request below it and for zero.
    test.assert_eq(mpu6050.rate_write(d, 1000), 3906)
    test.assert_eq(reg_of(c, 0x19), 255)
    test.assert_eq(mpu6050.rate_write(d, 0), 3906)
    test.assert_eq(mpu6050.rate_write(d, -5), 3906)
    // With the filter off the output rate is 8 kHz.
    c.regs.insert(0x1A, 0)
    test.assert_eq(mpu6050.rate_write(d, 1000000), 1000000)
    test.assert_eq(reg_of(c, 0x19), 7)
    test.assert_eq(mpu6050.rate_write(d, 8000000), 8000000)
    test.assert_eq(reg_of(c, 0x19), 0)

@test
fn test_the_rate_setter_answers_minus_one_for_a_part_that_refuses() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    test.assert_eq(mpu6050.rate_write(i2c_dut(c), 100000), -1)
    let e = chip()
    test.assert_eq(mpu6050.rate_write(flaky_write(e, 0x19, 1), 100000), -1)
    test.assert_eq(mpu6050.accel_rate_write(flaky_write(e, 0x19, 1), 100000), -1)
    test.assert_eq(mpu6050.gyro_rate_write(flaky_write(e, 0x19, 1), 100000), -1)

@test
fn test_one_divider_serves_both_sensors_and_a_rate_of_zero_is_standby() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x1A, 3)
    test.assert_eq(mpu6050.accel_rate_write(d, 100000), 100000)
    test.assert_eq(mpu6050.accel_rate_read(d), 100000)
    test.assert_eq(mpu6050.gyro_rate_read(d), 100000)
    // A rate of zero puts the three axes of one sensor in standby.
    test.assert_eq(mpu6050.accel_rate_write(d, 0), 0)
    test.assert_eq(reg_of(c, 0x6C), 0x38)
    test.assert_eq(mpu6050.accel_rate_read(d), 0)
    test.assert_eq(mpu6050.gyro_rate_read(d), 100000)
    test.assert_eq(mpu6050.gyro_rate_write(d, 0), 0)
    test.assert_eq(reg_of(c, 0x6C), 0x3F)
    test.assert_eq(mpu6050.gyro_rate_read(d), 0)
    // A rate brings them back.
    test.assert_eq(mpu6050.gyro_rate_write(d, 50000), 50000)
    test.assert_eq(reg_of(c, 0x6C), 0x38)
    test.assert_eq(mpu6050.accel_rate_write(d, 50000), 50000)
    test.assert_eq(reg_of(c, 0x6C), 0x00)
    // One axis of the three in standby is not standby.
    c.regs.insert(0x6C, 0x08)
    test.assert_eq(mpu6050.accel_rate_read(d), 50000)
    c.regs.insert(0x6C, 0x01)
    test.assert_eq(mpu6050.gyro_rate_read(d), 50000)

@test
fn test_the_rate_functions_answer_for_a_silent_part() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert_eq(mpu6050.accel_rate_read(d), -1)
    test.assert_eq(mpu6050.gyro_rate_read(d), -1)
    test.assert_eq(mpu6050.accel_rate_write(d, 0), -1)
    test.assert_eq(mpu6050.gyro_rate_write(d, 0), -1)
    test.assert_eq(mpu6050.accel_rate_write(d, 1000), -1)
    test.assert_eq(mpu6050.gyro_rate_write(d, 1000), -1)

@test
fn test_the_rates_in_whole_hertz_are_the_thousandths_rounded() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x1A, 3)
    test.assert_eq(mpu6050.accel_rate_hz_write(d, 100), 100)
    test.assert_eq(mpu6050.accel_rate_hz_read(d), 100)
    test.assert_eq(mpu6050.gyro_rate_hz_write(d, 3), 4)
    test.assert_eq(mpu6050.gyro_rate_hz_read(d), 4)
    test.assert_eq(mpu6050.hz_of_mhz(0), 0)
    test.assert_eq(mpu6050.hz_of_mhz(-1), 0)
    test.assert_eq(mpu6050.hz_of_mhz(3906), 4)
    test.assert_eq(mpu6050.hz_of_mhz(8000000), 8000)

// ── Power ────────────────────────────────────────────────────────────

@test
fn test_the_part_is_asleep_after_a_reset_and_run_wakes_it() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(mpu6050.mode_read(d) == Mpu6050Mode.Mpu6050Sleep)
    test.assert(mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Run))
    test.assert_eq(reg_of(c, 0x6B), 0x00)
    test.assert(mpu6050.mode_read(d) == Mpu6050Mode.Mpu6050Run)
    // The clock source stays.
    c.regs.insert(0x6B, 0x41)
    test.assert(mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Sleep))
    test.assert_eq(reg_of(c, 0x6B), 0x41)
    test.assert(mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Run))
    test.assert_eq(reg_of(c, 0x6B), 0x01)

@test
fn test_imu_control_sets_the_one_divider_both_sensors_share() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // The filter at 44 Hz: the output is 1 kHz.
    c.regs.insert(0x1A, 0x03)
    test.assert_eq(mpu6050.imu_rate_write(d, 100), 100)
    test.assert_eq(reg_of(c, 0x19), 9)
    test.assert_eq(mpu6050.imu_rate_read(d), 100)
    // The slowest rate at or above 3 Hz is 1000 / 256, 3.9 Hz, which reads
    // as 4 Hz.
    test.assert_eq(mpu6050.imu_rate_write(d, 3), 4)
    test.assert_eq(mpu6050.imu_rate_write(d, 0), 4)
    test.assert_eq(reg_of(c, 0x19), 255)
    test.assert_eq(mpu6050.imu_rate_read(d), 4)
    // Beyond the output rate takes the output rate.
    test.assert_eq(mpu6050.imu_rate_write(d, 5000), 1000)
    // The standby of the axes is left as it is.
    c.regs.insert(0x6C, 0x3F)
    test.assert_eq(mpu6050.imu_rate_write(d, 50), 50)
    test.assert_eq(reg_of(c, 0x6C), 0x3F)
    test.assert_eq(mpu6050.imu_rate_read(d), 50)
    // A part that does not answer takes none and reads none.
    c.st.insert(4, 0)
    test.assert_eq(mpu6050.imu_rate_write(d, 100), 0)
    test.assert_eq(mpu6050.imu_rate_read(d), 0)

@test
fn test_imu_control_puts_the_axes_in_standby_and_takes_them_out() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // The wake-up rate bits stay.
    c.regs.insert(0x6C, 0x80)
    test.assert(mpu6050.imu_standby_write(d, true, false))
    test.assert_eq(reg_of(c, 0x6C), 0xB8)
    test.assert(mpu6050.imu_standby_write(d, false, true))
    test.assert_eq(reg_of(c, 0x6C), 0x87)
    test.assert(mpu6050.imu_standby_write(d, true, true))
    test.assert_eq(reg_of(c, 0x6C), 0xBF)
    test.assert(mpu6050.imu_standby_write(d, false, false))
    test.assert_eq(reg_of(c, 0x6C), 0x80)
    // The ready flag clears on read, once for both.
    test.assert(not mpu6050.data_ready_of(d))
    c.st.insert(41, 0x01)
    test.assert(mpu6050.data_ready_of(d))
    test.assert(not mpu6050.data_ready_of(d))
    // A part that refuses.
    c.st.insert(4, 0)
    test.assert(not mpu6050.imu_standby_write(d, true, true))
    test.assert(not mpu6050.imu_standby_write(flaky_write(chip(), 0x6C, 1), true, true))

@test
fn test_cycle_mode_is_the_four_steps_of_the_register_map() [io, hw]
    // CYCLE set, SLEEP clear, TEMP_DIS set, the gyroscope axes in standby.
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x6B, 0x01)
    test.assert(mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Cycle))
    test.assert_eq(reg_of(c, 0x6B), 0x29)
    test.assert_eq(reg_of(c, 0x6C) & 0x07, 0x07)
    test.assert(mpu6050.mode_read(d) == Mpu6050Mode.Mpu6050Cycle)
    // Run undoes them.
    test.assert(mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Run))
    test.assert_eq(reg_of(c, 0x6B), 0x01)
    test.assert_eq(reg_of(c, 0x6C) & 0x07, 0x00)
    // Sleep wins over cycle, and leaves cycle clear.
    c.regs.insert(0x6B, 0x60)
    test.assert(mpu6050.mode_read(d) == Mpu6050Mode.Mpu6050Sleep)
    test.assert(mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Sleep))
    test.assert_eq(reg_of(c, 0x6B), 0x40)

@test
fn test_a_power_state_that_a_register_refuses_fails() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(mpu6050.mode_read(d) == Mpu6050Mode.Mpu6050Sleep)
    test.assert(not mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Sleep))
    test.assert(not mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Run))
    test.assert(not mpu6050.mode_write(d, Mpu6050Mode.Mpu6050Cycle))
    test.assert(not mpu6050.mode_write(flaky_write(chip(), 0x6C, 1), Mpu6050Mode.Mpu6050Run))
    test.assert(not mpu6050.mode_write(flaky_write(chip(), 0x6B, 1), Mpu6050Mode.Mpu6050Run))
    test.assert(not mpu6050.mode_write(flaky_write(chip(), 0x6C, 1), Mpu6050Mode.Mpu6050Cycle))
    test.assert(not mpu6050.mode_write(flaky_write(chip(), 0x6B, 1), Mpu6050Mode.Mpu6050Cycle))

@test
fn test_the_wake_up_rate_the_clock_and_the_temperature_sensor() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x6C, 0x07)
    test.assert(mpu6050.wake_write(d, 2))
    test.assert_eq(reg_of(c, 0x6C), 0x87)
    test.assert(mpu6050.wake_write(d, 0))
    test.assert_eq(reg_of(c, 0x6C), 0x07)
    test.assert(not mpu6050.wake_write(d, 4))
    test.assert(not mpu6050.wake_write(d, -1))
    c.regs.insert(0x6B, 0x40)
    test.assert(mpu6050.clock_write(d, 1))
    test.assert_eq(reg_of(c, 0x6B), 0x41)
    test.assert(mpu6050.clock_write(d, 5))
    test.assert_eq(reg_of(c, 0x6B), 0x45)
    test.assert(mpu6050.clock_write(d, 0))
    test.assert(not mpu6050.clock_write(d, 6))
    test.assert(not mpu6050.clock_write(d, 7))
    test.assert(not mpu6050.clock_write(d, -1))
    test.assert_eq(reg_of(c, 0x6B), 0x40)
    test.assert(mpu6050.temp_enable(d, false))
    test.assert_eq(reg_of(c, 0x6B), 0x48)
    test.assert(mpu6050.temp_enable(d, true))
    test.assert_eq(reg_of(c, 0x6B), 0x40)


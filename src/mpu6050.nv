// mpu6050 — TDK InvenSense's MPU-6050 six-axis motion tracking device, on
// its I2C bus, as devices-nv's `Accelerometer`, `Gyroscope`, `Imu`,
// `Thermometer` and `Identifiable`.
//
// The facts below are from TDK InvenSense's "MPU-6000 and MPU-6050 Product
// Specification", document PS-MPU-6000A-00 revision 3.4 (08/19/2013), and
// "MPU-6000 and MPU-6050 Register Map and Descriptions", document
// RM-MPU-6000A-00 revision 4.0 (03/09/2012); their sections and tables are
// named by number.  Where the documents and the drivers read for this one
// disagree, the site says which was taken.
//
// The register map (RM § 3), as this driver uses it:
//
//   0x0D  SELF_TEST_X   XA_TEST[4:2] (7:5), XG_TEST[4:0] (4:0)
//   0x0E  SELF_TEST_Y   YA_TEST[4:2] (7:5), YG_TEST[4:0] (4:0)
//   0x0F  SELF_TEST_Z   ZA_TEST[4:2] (7:5), ZG_TEST[4:0] (4:0)
//   0x10  SELF_TEST_A   XA_TEST[1:0] (5:4), YA_TEST[1:0] (3:2),
//                       ZA_TEST[1:0] (1:0)
//   0x19  SMPLRT_DIV    the divider of the gyroscope output rate
//   0x1A  CONFIG        EXT_SYNC_SET (5:3), DLPF_CFG (2:0)
//   0x1B  GYRO_CONFIG   XG_ST, YG_ST, ZG_ST (7:5), FS_SEL (4:3)
//   0x1C  ACCEL_CONFIG  XA_ST, YA_ST, ZA_ST (7:5), AFS_SEL (4:3)
//   0x23  FIFO_EN       TEMP (7), XG, YG, ZG (6:4), ACCEL (3), SLV2..0
//   0x37  INT_PIN_CFG   INT_LEVEL (7), INT_OPEN (6), LATCH_INT_EN (5),
//                       INT_RD_CLEAR (4), I2C_BYPASS_EN (1)
//   0x38  INT_ENABLE    MOT_EN (6), FIFO_OFLOW_EN (4), I2C_MST_INT_EN (3),
//                       DATA_RDY_EN (0)
//   0x3A  INT_STATUS    the same flags; clears on read
//   0x3B  ACCEL_XOUT_H .. 0x40 ACCEL_ZOUT_L   three 16-bit counts
//   0x41  TEMP_OUT_H, 0x42 TEMP_OUT_L
//   0x43  GYRO_XOUT_H .. 0x48 GYRO_ZOUT_L     three 16-bit counts
//   0x6A  USER_CTRL     FIFO_EN (6), I2C_MST_EN (5), I2C_IF_DIS (4),
//                       FIFO_RESET (2), I2C_MST_RESET (1), SIG_COND_RESET (0)
//   0x6B  PWR_MGMT_1    DEVICE_RESET (7), SLEEP (6), CYCLE (5),
//                       TEMP_DIS (3), CLKSEL (2:0); 0x40 after a reset
//   0x6C  PWR_MGMT_2    LP_WAKE_CTRL (7:6), STBY_XA, YA, ZA (5:3),
//                       STBY_XG, YG, ZG (2:0)
//   0x72  FIFO_COUNTH, 0x73 FIFO_COUNTL     bytes, high byte first
//   0x74  FIFO_R_W      the FIFO port
//   0x75  WHO_AM_I      0x68
//
// The data registers come in the order accelerometer, temperature,
// gyroscope, each a 16-bit two's complement count, high byte first, so
// one burst of fourteen registers from 0x3B is a whole sample.
//
// The step.  The product specification gives the accelerometer 16,384,
// 8,192, 4,096 and 2,048 LSB/g at ±2, ±4, ±8 and ±16 g (PS § 6.2) and the
// gyroscope 131, 65.5, 32.8 and 16.4 LSB per degree per second at ±250,
// ±500, ±1000 and ±2000 dps (PS § 6.1).  The driver converts with those
// numbers, the gyroscope's in tenths of a count.
//
// The temperature (RM § 4.19): degrees Celsius = TEMP_OUT / 340 + 36.53,
// which is milli-degrees = 36530 + TEMP_OUT * 1000 / 340.  PS § 6.3 gives
// the same line as 340 LSB per degree and -521 LSB at 35 degrees.
//
// The sample rate (RM § 4.2): the gyroscope output rate divided by
// 1 + SMPLRT_DIV, where the gyroscope output rate is 8 kHz when the digital
// low-pass filter is off (DLPF_CFG 0) and 1 kHz otherwise (RM § 4.3).  The
// accelerometer samples at 1 kHz, so above 1 kHz the same accelerometer
// sample is output more than once.  One divider serves both sensors.
//
// The bus.  The MPU-6050 is an I2C part at 0x68 (AD0 low) or 0x69 (high), at
// 400 kHz at most (PS § 6.4).  The SPI of the MPU-6000 is not on it.  A
// multiple-byte transfer advances the register address; the FIFO port does
// not advance it for a burst of a packet.  WHO_AM_I holds the upper six
// bits of the I2C address and so reads 0x68 at either address (RM § 4.34).
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/tdk/mpu6050` and the Rust crate `mpu6050` 0.1.6
// (`juliangaal/mpu6050`).  Each fix kept is named at its site.
//
// The driver holds no state: the full scales and the divider are read from
// the part in the transaction before the sample.
//
// A bus enters through `Mpu6050Port`, which a type that holds a bus
// implements: `Mpu6050` for an I2C bus.  The framing is the generic
// functions `i2c_read_into` and `i2c_write`, so a test runs them over a
// double of the bus.

use embedded_hal.{ BoardI2c, BoardGpio, BoardTimer, I2cBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, Accelerometer }
use dev_gyro.{ GyroMilliDps, GyroRange, Gyroscope }
use dev_imu.{ ImuSample, Imu }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let SELF_TEST_X  = 0x0D
let SMPLRT_DIV   = 0x19
let CONFIG       = 0x1A
let GYRO_CONFIG  = 0x1B
let ACCEL_CONFIG = 0x1C
let FIFO_EN      = 0x23
let INT_PIN_CFG  = 0x37
let INT_ENABLE   = 0x38
let INT_STATUS   = 0x3A
let ACCEL_XOUT_H = 0x3B
let TEMP_OUT_H   = 0x41
let GYRO_XOUT_H  = 0x43
let USER_CTRL    = 0x6A
let PWR_MGMT_1   = 0x6B
let PWR_MGMT_2   = 0x6C
let FIFO_COUNTH  = 0x72
let FIFO_R_W     = 0x74
let WHO_AM_I     = 0x75

// WHO_AM_I's value.
let ID_MPU6050 = 0x68

// PWR_MGMT_1: the reset, sleep, cycle and temperature bits, and the clock.
let PM1_RESET    = 0x80
let PM1_SLEEP    = 0x40
let PM1_CYCLE    = 0x20
let PM1_TEMP_DIS = 0x08
let PM1_CLK_MASK = 0x07
// The reset value of PWR_MGMT_1: asleep, on the internal oscillator.
let PM1_RESET_VALUE = 0x40
// The clock `start` selects: the PLL with the X gyroscope as reference.
let CLK_PLL_X = 1
// PWR_MGMT_2's standby bits, for the accelerometer and the gyroscope.
let PM2_STBY_ACCEL = 0x38
let PM2_STBY_GYRO  = 0x07
// INT_STATUS and INT_ENABLE's flags.
let INT_DATA_RDY = 0x01
// USER_CTRL: the FIFO enable and reset.
let UC_FIFO_EN    = 0x40
let UC_FIFO_RESET = 0x04
// FIFO_EN: the accelerometer, the three gyroscope axes, the temperature.
let FE_ACCEL = 0x08
let FE_GYRO  = 0x70
let FE_TEMP  = 0x80
// The bytes the FIFO holds; a count of this is an overflow (RM § 4.33).
let FIFO_BYTES = 1024
// The most samples the driver moves out of the FIFO into one list.
let LIST_DEPTH = 32

// The clock `setup` asks for: I2C fast mode.
let I2C_HZ = 400000

// The waits.  After a device reset the part is read after 100 ms, the wait
// of the Rust crate's `reset_device`; after the clock source is chosen the
// PLL settles in 1 to 10 ms and the gyroscope's zero-rate output in 30 ms
// (PS §§ 6.1, 6.6); the Rust crate waits 100 ms after the wake.
let WAIT_RESET_US   = 100000
let WAIT_WAKE_US    = 50000
let WAIT_POLL_US    = 1000
let RESET_POLLS     = 20
let SELF_TEST_POLLS = 4000

// The self-test (RM § 4.1): the gyroscope at ±250 dps and the accelerometer
// at ±8 g, ten samples passed and five averaged.
let ST_GYRO_CFG   = 0x00
let ST_ACCEL_CFG  = 0x10
let ST_GYRO_BITS  = 0xE0
let ST_ACCEL_BITS = 0xE0
let ST_SETTLE     = 10
let ST_AVERAGE    = 5

// INT_ENABLE's bits for `int_route`.

// The data-ready flag on the pin.
pub const INT_DRDY = 0x01

// The FIFO overflow flag on the pin.
pub const INT_FIFO_OVERFLOW = 0x10

// The power state of the part (RM §§ 4.30 and 4.31): asleep, running with
// both sensors, or cycling, the accelerometer-only low-power mode in which
// the part sleeps and wakes to take one accelerometer sample.
pub @value
enum Mpu6050Mode
    Mpu6050Sleep
    Mpu6050Run
    Mpu6050Cycle

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring has an address; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the INT pin; `wait_us` waits.
pub trait Mpu6050Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]
    fn wait_us(self, us: Int) [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Makes an I2C bus ready: the INT pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// The level of the part's INT line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Mpu6050Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register with a bit that clears itself is written
// with `write_reg`.
pub fn reg_write<P: Mpu6050Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `v`, leaving the others:
// whether the part took it.
//
// Fix kept: the Rust crate sets and clears single bits and fields, since
// the registers hold bits the other settings own (INT_PIN_CFG's
// I2C_BYPASS_EN, PWR_MGMT_1's CLKSEL beside SLEEP).
pub fn reg_update<P: Mpu6050Port>(p: P, reg: Int, mask: Int, v: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (v & mask))

// ── Identity ─────────────────────────────────────────────────────────

// WHO_AM_I as a `DeviceId`, or `None` when no part answers: the byte reads
// 0xFF on a bus no part drives and 0x00 on one held low.
pub fn id_read<P: Mpu6050Port>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, WHO_AM_I) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Ranges and steps ─────────────────────────────────────────────────

// The accelerometer range an ACCEL_CONFIG byte selects (RM § 4.5): 0 ±2 g,
// 1 ±4 g, 2 ±8 g, 3 ±16 g.
pub fn accel_range_of(cfg: Int) -> AccelRange
    match (cfg >> 3) & 3
        0 => AccelRange2g
        1 => AccelRange4g
        2 => AccelRange8g
        _ => AccelRange16g

// The AFS_SEL code for a range.
pub fn accel_fs_of(r: AccelRange) -> Int
    match r
        AccelRange2g  => 0
        AccelRange4g  => 1
        AccelRange8g  => 2
        AccelRange16g => 3

// The gyroscope range a GYRO_CONFIG byte selects (RM § 4.4): 0 ±250, 1 ±500,
// 2 ±1000, 3 ±2000 dps.
pub fn gyro_range_of(cfg: Int) -> GyroRange
    match (cfg >> 3) & 3
        0 => GyroRange250dps
        1 => GyroRange500dps
        2 => GyroRange1000dps
        _ => GyroRange2000dps

// The FS_SEL code for a range.
pub fn gyro_fs_of(r: GyroRange) -> Int
    match r
        GyroRange250dps  => 0
        GyroRange500dps  => 1
        GyroRange1000dps => 2
        GyroRange2000dps => 3

// The accelerometer's counts per g (PS § 6.2).
pub fn lsb_per_g(cfg: Int) -> Int
    match (cfg >> 3) & 3
        0 => 16384
        1 => 8192
        2 => 4096
        _ => 2048

// The gyroscope's counts per degree per second, in tenths (PS § 6.1): 131,
// 65.5, 32.8 and 16.4.
pub fn tenth_lsb_per_dps(cfg: Int) -> Int
    match (cfg >> 3) & 3
        0 => 1310
        1 => 655
        2 => 328
        _ => 164

// The signed 16-bit count at `i` of `b`, high byte first.
fn s16_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i] as Int << 8) | b[i + 1] as Int, 16)

// The milli-g of the three axes at `i` of `b`, for `lsb` counts per g.
fn accel_at(b: DevBytes, i: Int, lsb: Int) -> AccelMilliG
    AccelMilliG { x: s16_at(b, i) * 1000 / lsb,
        y: s16_at(b, i + 2) * 1000 / lsb,
        z: s16_at(b, i + 4) * 1000 / lsb }

// The milli-degrees per second of the three axes at `i` of `b`, for `tenth`
// tenths of a count per degree per second.
fn gyro_at(b: DevBytes, i: Int, tenth: Int) -> GyroMilliDps
    GyroMilliDps { x: s16_at(b, i) * 10000 / tenth,
        y: s16_at(b, i + 2) * 10000 / tenth,
        z: s16_at(b, i + 4) * 10000 / tenth }

// The temperature at `i` of `b` in milli-degrees Celsius: TEMP_OUT / 340 +
// 36.53 (RM § 4.19).
fn temp_at(b: DevBytes, i: Int) -> TempMilliC
    TempMilliC { milli_c: 36530 + s16_at(b, i) * 1000 / 340 }

// ── Samples ──────────────────────────────────────────────────────────

// The most recent acceleration in milli-g: the full scale, then the six
// output registers, in two transactions.  `None` when the part did not
// answer.
pub fn accel_read_of<P: Mpu6050Port>(p: P) -> ?AccelMilliG [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(ACCEL_XOUT_H, 6, var b)
        return None
    Some(accel_at(b, 0, lsb_per_g(r[1] as Int)))

// The most recent rate of turn in milli-degrees per second, read the same
// way.
pub fn gyro_read_of<P: Mpu6050Port>(p: P) -> ?GyroMilliDps [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(GYRO_XOUT_H, 6, var b)
        return None
    Some(gyro_at(b, 0, tenth_lsb_per_dps(r[0] as Int)))

// Both from one burst of fourteen registers, the acceleration first, then
// the temperature, then the rate of turn: one sample as far as the part's
// registers go.
pub fn imu_read_of<P: Mpu6050Port>(p: P) -> ?ImuSample [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(ACCEL_XOUT_H, 14, var b)
        return None
    Some(ImuSample { accel: accel_at(b, 0, lsb_per_g(r[1] as Int)),
        gyro: gyro_at(b, 8, tenth_lsb_per_dps(r[0] as Int)) })

// INT_STATUS, whose flags clear when it is read: `None` when the part did
// not answer.
pub fn int_status<P: Mpu6050Port>(p: P) -> ?Int [hw]
    reg_read(p, INT_STATUS)

// Whether a new sample has completed since INT_STATUS was last read:
// DATA_RDY_INT.  The one flag serves both sensors, and reading it clears
// it, so the second of two calls answers false until the next sample.
pub fn data_ready_of<P: Mpu6050Port>(p: P) -> Bool [hw]
    ((int_status(p) ?? 0) & INT_DATA_RDY) != 0

// The die temperature in milli-degrees Celsius (RM § 4.19): TEMP_OUT / 340
// + 36.53.  `None` when the part did not answer.
pub fn temp_read_of<P: Mpu6050Port>(p: P) -> ?TempMilliC [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(TEMP_OUT_H, 2, var b)
        return None
    Some(temp_at(b, 0))

// ── Full scale, filter and rate ──────────────────────────────────────

// The accelerometer range, ±2 g when the part does not answer.
pub fn accel_range_read<P: Mpu6050Port>(p: P) -> AccelRange [hw]
    accel_range_of(reg_read(p, ACCEL_CONFIG) ?? 0)

// Sets the accelerometer range and leaves the self-test bits: whether the
// part took it.
pub fn accel_range_write<P: Mpu6050Port>(p: P, r: AccelRange) -> Bool [hw]
    reg_update(p, ACCEL_CONFIG, 0x18, accel_fs_of(r) << 3)

// The gyroscope range, ±250 dps when the part does not answer.
pub fn gyro_range_read<P: Mpu6050Port>(p: P) -> GyroRange [hw]
    gyro_range_of(reg_read(p, GYRO_CONFIG) ?? 0)

// Sets the gyroscope range and leaves the self-test bits: whether the part
// took it.
pub fn gyro_range_write<P: Mpu6050Port>(p: P, r: GyroRange) -> Bool [hw]
    reg_update(p, GYRO_CONFIG, 0x18, gyro_fs_of(r) << 3)

// The digital low-pass filter, DLPF_CFG 0 to 6 (RM § 4.3), or -1 when the
// part did not answer.  0 is 260 Hz for the accelerometer and 256 Hz for the
// gyroscope with the gyroscope output at 8 kHz; 1 to 6 are 184, 94, 44, 21,
// 10 and 5 Hz for the accelerometer and 188, 98, 42, 20, 10 and 5 Hz for the
// gyroscope, with the gyroscope output at 1 kHz.
pub fn dlpf_read<P: Mpu6050Port>(p: P) -> Int [hw]
    let Some(v) = reg_read(p, CONFIG) else return -1
    v & 7

// Sets DLPF_CFG, 0 to 6, and leaves EXT_SYNC_SET: whether the part took it.
// 7 is reserved and refused.  The sample rate follows the filter: the
// divider divides 8 kHz with the filter off and 1 kHz with it on.
pub fn dlpf_write<P: Mpu6050Port>(p: P, cfg: Int) -> Bool [hw]
    if cfg < 0 or cfg > 6
        return false
    reg_update(p, CONFIG, 0x07, cfg)

// The gyroscope output rate in thousandths of a hertz for a CONFIG byte:
// 8 kHz with DLPF_CFG 0 and 7, 1 kHz otherwise (RM § 4.2).
pub fn base_mhz_of(config: Int) -> Int
    let d = config & 7
    if d == 0 or d == 7
        return 8000000
    1000000

// The sample rate in thousandths of a hertz, -1 when the part did not
// answer.  CONFIG is read first and the divider after it.
pub fn rate_read<P: Mpu6050Port>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CONFIG, 1, var b)
        return -1
    var d: DevBytes = Vec.new()
    if not p.read_regs(SMPLRT_DIV, 1, var d)
        return -1
    base_mhz_of(b[0] as Int) / (1 + d[0] as Int)

// Sets the sample rate to the slowest rate at or above `mhz` thousandths of
// a hertz, 1 + SMPLRT_DIV dividing the output rate of the filter in use, and
// answers the rate taken; -1 when the part did not take it.  The slowest
// rate is 1/256 of the output rate (3.9 Hz at 1 kHz) and the fastest the
// output rate.  A request of 0 or less takes the slowest.
//
// Fix kept: the divider is one for both sensors, and the accelerometer's
// 1 kHz is the ceiling of its fresh samples, which RM § 4.2 notes.
pub fn rate_write<P: Mpu6050Port>(p: P, mhz: Int) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CONFIG, 1, var b)
        return -1
    let base = base_mhz_of(b[0] as Int)
    var n = 256
    if mhz > 0
        n = base / mhz
    if n < 1
        n = 1
    if n > 256
        n = 256
    if not reg_write(p, SMPLRT_DIV, n - 1)
        return -1
    base / n

// The accelerometer rate in thousandths of a hertz: the sample rate, 0 when
// the three accelerometer axes are in standby, -1 when the part did not
// answer.
pub fn accel_rate_read<P: Mpu6050Port>(p: P) -> Int [hw]
    let Some(pm2) = reg_read(p, PWR_MGMT_2) else return -1
    if (pm2 & PM2_STBY_ACCEL) == PM2_STBY_ACCEL
        return 0
    rate_read(p)

// Sets the sample rate for both sensors (`rate_write`) and takes the
// accelerometer out of standby; a request of 0 puts the three accelerometer
// axes in standby instead and answers 0.  -1 when the part did not take it.
pub fn accel_rate_write<P: Mpu6050Port>(p: P, mhz: Int) -> Int [hw]
    if mhz <= 0
        if not reg_update(p, PWR_MGMT_2, PM2_STBY_ACCEL, PM2_STBY_ACCEL)
            return -1
        return 0
    if not reg_update(p, PWR_MGMT_2, PM2_STBY_ACCEL, 0)
        return -1
    rate_write(p, mhz)

// The gyroscope rate in thousandths of a hertz: the sample rate, 0 when the
// three gyroscope axes are in standby, -1 when the part did not answer.
pub fn gyro_rate_read<P: Mpu6050Port>(p: P) -> Int [hw]
    let Some(pm2) = reg_read(p, PWR_MGMT_2) else return -1
    if (pm2 & PM2_STBY_GYRO) == PM2_STBY_GYRO
        return 0
    rate_read(p)

// The same for the gyroscope: a request of 0 puts its three axes in standby.
pub fn gyro_rate_write<P: Mpu6050Port>(p: P, mhz: Int) -> Int [hw]
    if mhz <= 0
        if not reg_update(p, PWR_MGMT_2, PM2_STBY_GYRO, PM2_STBY_GYRO)
            return -1
        return 0
    if not reg_update(p, PWR_MGMT_2, PM2_STBY_GYRO, 0)
        return -1
    rate_write(p, mhz)

// A rate in thousandths of a hertz as whole hertz: to the nearest, 0 for
// off.
pub fn hz_of_mhz(mhz: Int) -> Int
    if mhz <= 0
        return 0
    (mhz + 500) / 1000

// The rate in whole hertz for the traits.
pub fn accel_rate_hz_read<P: Mpu6050Port>(p: P) -> Int [hw]
    hz_of_mhz(accel_rate_read(p))

// The rate taken in whole hertz after `hz` was asked for.
pub fn accel_rate_hz_write<P: Mpu6050Port>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(accel_rate_write(p, hz * 1000))

// The gyroscope's rate in whole hertz.
pub fn gyro_rate_hz_read<P: Mpu6050Port>(p: P) -> Int [hw]
    hz_of_mhz(gyro_rate_read(p))

// The gyroscope's rate taken in whole hertz after `hz` was asked for.
pub fn gyro_rate_hz_write<P: Mpu6050Port>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(gyro_rate_write(p, hz * 1000))

// ── Power ────────────────────────────────────────────────────────────

// The power state, asleep when the part does not answer.  SLEEP wins over
// CYCLE.
pub fn mode_read<P: Mpu6050Port>(p: P) -> Mpu6050Mode [hw]
    let v = reg_read(p, PWR_MGMT_1) ?? PM1_SLEEP
    if (v & PM1_SLEEP) != 0
        return Mpu6050Sleep
    if (v & PM1_CYCLE) != 0
        return Mpu6050Cycle
    Mpu6050Run

// Puts the part to sleep: SLEEP set, CYCLE clear.
fn mode_sleep<P: Mpu6050Port>(p: P) -> Bool [hw]
    reg_update(p, PWR_MGMT_1, PM1_SLEEP | PM1_CYCLE, PM1_SLEEP)

// Wakes the part with every sensor on: the gyroscope axes out of standby,
// then SLEEP, CYCLE and TEMP_DIS clear.
fn mode_run<P: Mpu6050Port>(p: P) -> Bool [hw]
    if not reg_update(p, PWR_MGMT_2, PM2_STBY_GYRO, 0)
        return false
    reg_update(p, PWR_MGMT_1, PM1_SLEEP | PM1_CYCLE | PM1_TEMP_DIS, 0)

// The accelerometer-only low-power mode: the gyroscope axes in standby,
// then CYCLE and TEMP_DIS set and SLEEP clear.
fn mode_cycle<P: Mpu6050Port>(p: P) -> Bool [hw]
    if not reg_update(p, PWR_MGMT_2, PM2_STBY_GYRO, PM2_STBY_GYRO)
        return false
    reg_update(p, PWR_MGMT_1, PM1_SLEEP | PM1_CYCLE | PM1_TEMP_DIS, PM1_CYCLE | PM1_TEMP_DIS)

// Sets the power state: whether the part took it.  The part comes up asleep
// (PWR_MGMT_1 is 0x40 after a reset, RM § 4), and `Mpu6050Run` wakes it with
// every sensor on.  `Mpu6050Cycle` is the accelerometer-only low-power mode
// of RM § 4.31: CYCLE set and SLEEP clear, the temperature sensor off and
// the three gyroscope axes in standby; the wake-up rate is `wake_write`.
// `Mpu6050Run` and `Mpu6050Sleep` leave the clock source and the standby
// bits as they are, apart from the ones the cycle mode set, which Run clears.
pub fn mode_write<P: Mpu6050Port>(p: P, m: Mpu6050Mode) -> Bool [hw]
    match m
        Mpu6050Sleep => mode_sleep(p)
        Mpu6050Run   => mode_run(p)
        Mpu6050Cycle => mode_cycle(p)

// Sets the wake-up rate of the cycle mode, LP_WAKE_CTRL 0 to 3: 1.25, 5, 20
// and 40 Hz (RM § 4.31).  Whether the part took it; 4 and above are refused.
pub fn wake_write<P: Mpu6050Port>(p: P, ctrl: Int) -> Bool [hw]
    if ctrl < 0 or ctrl > 3
        return false
    reg_update(p, PWR_MGMT_2, 0xC0, ctrl << 6)

// Selects the clock source, CLKSEL 0 to 5 (RM § 4.30): 0 the internal 8 MHz
// oscillator, 1 to 3 the PLL with the X, Y or Z gyroscope as reference, 4
// and 5 the PLL with an external 32.768 kHz or 19.2 MHz clock.  6 is
// reserved and 7 stops the clock; both are refused.  Whether the part took
// it.
pub fn clock_write<P: Mpu6050Port>(p: P, sel: Int) -> Bool [hw]
    if sel < 0 or sel > 5
        return false
    reg_update(p, PWR_MGMT_1, PM1_CLK_MASK, sel)

// Turns the temperature sensor on or off (TEMP_DIS): whether the part took
// it.
pub fn temp_enable<P: Mpu6050Port>(p: P, on: Bool) -> Bool [hw]
    var v = 0
    if not on
        v = PM1_TEMP_DIS
    reg_update(p, PWR_MGMT_1, PM1_TEMP_DIS, v)

// ── Interrupt pin ────────────────────────────────────────────────────

// Sets INT_ENABLE to `mask`, built from the `INT_` constants: whether the
// part took it.  `start` sets the data-ready flag.
pub fn int_route<P: Mpu6050Port>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT_ENABLE, mask)

// Sets the pin's polarity and output type: `active_low` makes it active low,
// `open_drain` makes it open-drain in place of push-pull.  The latch and
// clear bits and I2C_BYPASS_EN stay.  Whether the part took it.
pub fn int_pin_config<P: Mpu6050Port>(p: P, active_low: Bool, open_drain: Bool) -> Bool [hw]
    var v = 0
    if active_low
        v = v | 0x80
    if open_drain
        v = v | 0x40
    reg_update(p, INT_PIN_CFG, 0xC0, v)

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO is 1024 bytes (RM § 4.33).  It is off after `start`.
// `fifo_start` turns it on with the accelerometer batched, and the three
// gyroscope axes too when asked, at the sample rate.  The part writes the
// registers in order of address, so a sample is the accelerometer's six
// bytes and the gyroscope's six, 12 bytes for both and 6 for one.  When the
// FIFO is full the oldest byte is lost, so after an overflow the bytes no
// longer start at a sample.  The part has no watermark; the program reads
// the count, or takes the overflow flag to an interrupt.

// The bytes of one sample for a FIFO_EN byte: 12 for the accelerometer and
// the three gyroscope axes, 6 for the accelerometer alone, 0 for anything
// else (another set of axes, the temperature or an external sensor).
fn sample_len(fifo_en: Int) -> Int
    if (fifo_en & 0x87) != 0
        return 0
    let a = (fifo_en & FE_ACCEL) != 0
    let g = (fifo_en & FE_GYRO) == FE_GYRO
    let none = (fifo_en & FE_GYRO) == 0
    if a and g
        return 12
    if a and none
        return 6
    0

// The number of samples in the FIFO, 0 when it is empty, when the FIFO is
// not set to the accelerometer or to the accelerometer and the gyroscope,
// or when the part did not answer: FIFO_COUNT in bytes, divided by the
// bytes of a sample.  Reading the high byte latches both registers
// (RM § 4.32), so they are read in one burst.
pub fn fifo_count<P: Mpu6050Port>(p: P) -> Int [hw]
    var f: DevBytes = Vec.new()
    if not p.read_regs(FIFO_EN, 1, var f)
        return 0
    let len = sample_len(f[0] as Int)
    if len == 0
        return 0
    var b: DevBytes = Vec.new()
    if not p.read_regs(FIFO_COUNTH, 2, var b)
        return 0
    ((b[0] as Int << 8) | b[1] as Int) / len

// Turns the FIFO on: the accelerometer is batched, and the gyroscope when
// `with_gyro`; whether the part took every setting.  The FIFO is reset
// first, which USER_CTRL does only while FIFO_EN is clear.
//
// Fix kept: the FIFO is reset with FIFO_EN clear and enabled after the
// choice of what it holds (RM §§ 4.7 and 4.29).
pub fn fifo_start<P: Mpu6050Port>(p: P, with_gyro: Bool) -> Bool [hw]
    var en = FE_ACCEL
    if with_gyro
        en = en | FE_GYRO
    if not reg_update(p, USER_CTRL, UC_FIFO_EN, 0)
        return false
    if not p.write_reg(USER_CTRL, UC_FIFO_RESET)
        return false
    if not reg_write(p, FIFO_EN, en)
        return false
    reg_update(p, USER_CTRL, UC_FIFO_EN, UC_FIFO_EN)

// Turns the FIFO off and empties it: whether the part took every setting.
pub fn fifo_stop<P: Mpu6050Port>(p: P) -> Bool [hw]
    if not reg_update(p, USER_CTRL, UC_FIFO_EN, 0)
        return false
    if not reg_write(p, FIFO_EN, 0)
        return false
    p.write_reg(USER_CTRL, UC_FIFO_RESET)

// Empties the FIFO while it stays on: FIFO_EN is cleared for the reset and
// set again.  Whether the part took it.
fn fifo_flush<P: Mpu6050Port>(p: P) -> Bool [hw]
    if not reg_update(p, USER_CTRL, UC_FIFO_EN, 0)
        return false
    if not p.write_reg(USER_CTRL, UC_FIFO_RESET)
        return false
    reg_update(p, USER_CTRL, UC_FIFO_EN, UC_FIFO_EN)

// Takes one sample of `len` bytes out of the FIFO into `b`: whether the part
// answered.
fn fifo_sample<P: Mpu6050Port>(p: P, len: Int, var b: DevBytes) -> Bool [hw]
    p.read_regs(FIFO_R_W, len, var b)

// The samples the FIFO holds, or 0 after an overflow.  A count of 1024 is a
// FIFO that has lost its oldest bytes, so the bytes no longer start at a
// sample; the FIFO is emptied and 0 is answered.
//
// Fix kept: the data sheet says the oldest data is lost on an overflow and
// that the count is of bytes (RM §§ 4.32 and 4.33); 1024 is not a multiple
// of 12, so a program that went on reading would pair the wrong bytes.
fn fifo_ready<P: Mpu6050Port>(p: P, len: Int) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(FIFO_COUNTH, 2, var b)
        return 0
    let held = (b[0] as Int << 8) | b[1] as Int
    if held >= FIFO_BYTES
        let _ = fifo_flush(p)
        return 0
    held / len

// Moves the accelerometer's samples of the FIFO, oldest first, into `dst`,
// which is emptied first, and answers how many samples it took out.  The
// gyroscope's half of a sample is taken out and dropped.  A FIFO that has
// overflowed is emptied and gives 0.
pub fn fifo_read<P: Mpu6050Port>(p: P, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
    dst.clear()
    var f: DevBytes = Vec.new()
    if not p.read_regs(FIFO_EN, 1, var f)
        return 0
    let len = sample_len(f[0] as Int)
    if len == 0
        return 0
    let n = fifo_ready(p, len)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(ACCEL_CONFIG, 1, var r)
        return 0
    let lsb = lsb_per_g(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if dst.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        if not fifo_sample(p, len, var b)
            break
        moved = moved + 1
        let _ = dst.push(accel_at(b, 0, lsb))
    moved

// Moves the FIFO's samples into `accel` and `gyro`, each emptied first,
// oldest first, and answers how many samples it took out.  It stops when
// either list is full, so no sample is taken out without room.  A FIFO
// that holds the accelerometer alone fills `accel` only.
pub fn fifo_read_imu<P: Mpu6050Port>(p: P, var accel: Vec[AccelMilliG; 32],
                                     var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
    accel.clear()
    gyro.clear()
    var f: DevBytes = Vec.new()
    if not p.read_regs(FIFO_EN, 1, var f)
        return 0
    let len = sample_len(f[0] as Int)
    if len == 0
        return 0
    let n = fifo_ready(p, len)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(GYRO_CONFIG, 2, var r)
        return 0
    let lsb = lsb_per_g(r[1] as Int)
    let tenth = tenth_lsb_per_dps(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if accel.len() >= LIST_DEPTH or gyro.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        if not fifo_sample(p, len, var b)
            break
        moved = moved + 1
        let _ = accel.push(accel_at(b, 0, lsb))
        if len == 12
            let _ = gyro.push(gyro_at(b, 6, tenth))
    moved

// ── Self-test ────────────────────────────────────────────────────────
//
// RM § 4.1: the self-test response is the output with the self-test enabled
// minus the output with it disabled, and the part passes when the change
// from the factory trim value, (response - trim) / trim, is within ±14 %
// (PS §§ 6.1 and 6.2).  The factory trim comes from the SELF_TEST registers.

// The factory trim of a gyroscope axis in milli-degrees per second for an
// XG_TEST, YG_TEST or ZG_TEST of 1 to 31: 25 * 1.046^(n - 1) degrees per
// second, which is 25 * 131 * 1.046^(n - 1) counts at ±250 dps (RM § 4.1).
// 0 for a test value of 0 and outside the range.
pub fn gyro_trim_mdps(test: Int) -> Int
    match test
        1  => 25000
        2  => 26150
        3  => 27353
        4  => 28611
        5  => 29927
        6  => 31304
        7  => 32744
        8  => 34250
        9  => 35826
        10 => 37474
        11 => 39197
        12 => 41000
        13 => 42886
        14 => 44859
        15 => 46923
        16 => 49081
        17 => 51339
        18 => 53701
        19 => 56171
        20 => 58755
        21 => 61457
        22 => 64284
        23 => 67241
        24 => 70335
        25 => 73570
        26 => 76954
        27 => 80494
        28 => 84197
        29 => 88070
        30 => 92121
        31 => 96359
        _  => 0

// The factory trim of an accelerometer axis in milli-g for an XA_TEST,
// YA_TEST or ZA_TEST of 1 to 31: 4096 * 0.34 * (0.92 / 0.34)^((n - 1) / 30)
// counts at ±8 g, which is 340 * (0.92 / 0.34)^((n - 1) / 30) milli-g (RM
// § 4.1).  0 for a test value of 0 and outside the range.
pub fn accel_trim_mg(test: Int) -> Int
    match test
        1  => 340
        2  => 351
        3  => 363
        4  => 376
        5  => 388
        6  => 401
        7  => 415
        8  => 429
        9  => 443
        10 => 458
        11 => 474
        12 => 490
        13 => 506
        14 => 523
        15 => 541
        16 => 559
        17 => 578
        18 => 598
        19 => 618
        20 => 639
        21 => 660
        22 => 682
        23 => 706
        24 => 729
        25 => 754
        26 => 779
        27 => 806
        28 => 833
        29 => 861
        30 => 890
        31 => 920
        _  => 0

// The gyroscope's factory trim, in milli-degrees per second, from the
// SELF_TEST registers: the X and Z values are positive and the Y value is
// negative (RM § 4.1).  `None` when the part did not answer.
pub fn gyro_trim_read<P: Mpu6050Port>(p: P) -> ?GyroMilliDps [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(SELF_TEST_X, 3, var b)
        return None
    Some(GyroMilliDps { x: gyro_trim_mdps(b[0] as Int & 0x1F),
        y: 0 - gyro_trim_mdps(b[1] as Int & 0x1F),
        z: gyro_trim_mdps(b[2] as Int & 0x1F) })

// The accelerometer's factory trim, in milli-g: each axis's test value is
// the upper three bits in its own register and the lower two in
// SELF_TEST_A (RM § 4.1).  `None` when the part did not answer.
pub fn accel_trim_read<P: Mpu6050Port>(p: P) -> ?AccelMilliG [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(SELF_TEST_X, 4, var b)
        return None
    let a = b[3] as Int
    Some(AccelMilliG { x: accel_trim_mg((((b[0] as Int >> 5) & 7) << 2) | ((a >> 4) & 3)),
        y: accel_trim_mg((((b[1] as Int >> 5) & 7) << 2) | ((a >> 2) & 3)),
        z: accel_trim_mg((((b[2] as Int >> 5) & 7) << 2) | (a & 3)) })

// The magnitude of `v`.
fn abs_of(v: Int) -> Int
    if v < 0
        return 0 - v
    v

// Whether the response `r` is within ±14 % of the factory trim `ft`
// (PS §§ 6.1 and 6.2): false for a trim of 0, which a part reports when no
// trim was written.
fn within_14(r: Int, ft: Int) -> Bool
    if ft == 0
        return false
    abs_of(r - ft) * 100 <= 14 * abs_of(ft)

// Whether every axis of the accelerometer's self-test response is within
// ±14 % of its factory trim.
pub fn accel_self_test_ok(r: AccelMilliG, ft: AccelMilliG) -> Bool
    within_14(r.x, ft.x) and within_14(r.y, ft.y) and within_14(r.z, ft.z)

// The same for the gyroscope.
pub fn gyro_self_test_ok(r: GyroMilliDps, ft: GyroMilliDps) -> Bool
    within_14(r.x, ft.x) and within_14(r.y, ft.y) and within_14(r.z, ft.z)

// Waits for the data-ready flag by polling INT_STATUS, at most
// `SELF_TEST_POLLS` times: whether it came.
fn wait_ready<P: Mpu6050Port>(p: P) -> Bool [hw]
    for _i in 0..SELF_TEST_POLLS
        if data_ready_of(p)
            return true
    false

// Lets `ST_SETTLE` samples pass and averages the next `ST_AVERAGE`, in
// milli-g: `None` when a sample did not come.
fn accel_mean<P: Mpu6050Port>(p: P) -> ?AccelMilliG [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..ST_SETTLE + ST_AVERAGE
        if not wait_ready(p)
            return None
        let Some(s) = accel_read_of(p) else return None
        if i >= ST_SETTLE
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(AccelMilliG { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The same for the gyroscope, in milli-degrees per second.
fn gyro_mean<P: Mpu6050Port>(p: P) -> ?GyroMilliDps [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..ST_SETTLE + ST_AVERAGE
        if not wait_ready(p)
            return None
        let Some(s) = gyro_read_of(p) else return None
        if i >= ST_SETTLE
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(GyroMilliDps { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The accelerometer's self-test response (RM § 4.5): the accelerometer at
// ±8 g is read with the self-test off and again with XA_ST, YA_ST and ZA_ST
// set, five samples averaged each time after ten have passed, and the
// answer is the second mean minus the first, in milli-g.  ACCEL_CONFIG is
// put back.  The board must be still.  `None` when the part did not answer
// or a sample did not come.  `accel_self_test_ok` compares it with
// `accel_trim_read`.
pub fn accel_self_test<P: Mpu6050Port>(p: P) -> ?AccelMilliG [hw]
    let Some(save) = reg_read(p, ACCEL_CONFIG) else return None
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_write(p, ACCEL_CONFIG, ST_ACCEL_CFG)
        if let Some(off) = accel_mean(p)
            if reg_write(p, ACCEL_CONFIG, ST_ACCEL_CFG | ST_ACCEL_BITS)
                if let Some(on) = accel_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back = reg_write(p, ACCEL_CONFIG, save)
    if not ok
        return None
    Some(AccelMilliG { x: dx, y: dy, z: dz })

// The gyroscope's self-test response (RM § 4.4), with the gyroscope at ±250
// dps, in milli-degrees per second.
pub fn gyro_self_test<P: Mpu6050Port>(p: P) -> ?GyroMilliDps [hw]
    let Some(save) = reg_read(p, GYRO_CONFIG) else return None
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_write(p, GYRO_CONFIG, ST_GYRO_CFG)
        if let Some(off) = gyro_mean(p)
            if reg_write(p, GYRO_CONFIG, ST_GYRO_CFG | ST_GYRO_BITS)
                if let Some(on) = gyro_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back = reg_write(p, GYRO_CONFIG, save)
    if not ok
        return None
    Some(GyroMilliDps { x: dx, y: dy, z: dz })

// ── Bring-up ─────────────────────────────────────────────────────────

// Waits for the device reset to finish: PWR_MGMT_1 reads its reset value,
// 0x40 (RM § 4.30), which has DEVICE_RESET clear again.  A read that fails
// counts as not finished.  Whether it finished within `RESET_POLLS` polls.
fn wait_reset<P: Mpu6050Port>(p: P) -> Bool [hw]
    for _i in 0..RESET_POLLS
        if reg_read(p, PWR_MGMT_1) == Some(PM1_RESET_VALUE)
            return true
        p.wait_us(WAIT_POLL_US)
    false

// Brings the part up: the bus made ready; a device reset, waited for and
// polled; WHO_AM_I checked; the part woken on the PLL with the X gyroscope
// as the clock reference; every axis out of standby; the digital low-pass
// filter at 44 Hz (DLPF_CFG 3) and the sample rate at 100 Hz; ±2 g and ±250
// dps; the FIFO and the I2C master off; the INT pin push-pull, active high,
// a 50 us pulse; and the data-ready flag enabled.  Answers whether the part
// answered as an MPU-6050 and took every setting.  The first samples come
// one period after the wake, and the gyroscope's zero-rate output settles
// in 30 ms (PS § 6.1), which is waited here.
//
// Fixes kept: the part comes up asleep and on its internal oscillator, and
// the Rust crate's `wake` and Zephyr's `mpu6050_init` clear SLEEP, the crate
// choosing the PLL with the X gyroscope, which RM § 4.30 recommends over the
// internal oscillator; the crate waits 100 ms after a device reset and
// after the wake; WHO_AM_I is 0x68 for the MPU-6050 and other values are
// other parts (Zephyr accepts the MPU-6500's and the MPU-9250's as parts
// of another register map), so only 0x68 is taken; `I2C_IF_DIS` is written
// 0 on the MPU-6050 (RM § 4.29).
pub fn start<P: Mpu6050Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if not p.write_reg(PWR_MGMT_1, PM1_RESET)
        return false
    p.wait_us(WAIT_RESET_US)
    if not wait_reset(p)
        return false
    if reg_read(p, WHO_AM_I) != Some(ID_MPU6050)
        return false
    if not reg_write(p, PWR_MGMT_1, CLK_PLL_X)
        return false
    p.wait_us(WAIT_WAKE_US)
    if not reg_write(p, PWR_MGMT_2, 0)
        return false
    if not reg_write(p, USER_CTRL, 0)
        return false
    if not reg_write(p, FIFO_EN, 0)
        return false
    if not reg_write(p, CONFIG, 3)
        return false
    if not reg_write(p, SMPLRT_DIV, 9)
        return false
    if not reg_write(p, GYRO_CONFIG, 0)
        return false
    if not reg_write(p, ACCEL_CONFIG, 0)
        return false
    if not reg_write(p, INT_PIN_CFG, 0)
        return false
    reg_write(p, INT_ENABLE, INT_DATA_RDY)

// ── The part on an I2C bus ───────────────────────────────────────────

// An MPU-6050 on a board's I2C bus at the address `w.addr`, 0x68 or 0x69,
// with the board's GPIO for the INT line and its timer.
pub @value
struct Mpu6050
    bus: BoardI2c
    pins: BoardGpio
    timer: BoardTimer
    w: DeviceWiring

impl Mpu6050Port for Mpu6050
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn wait_us(self, us: Int) [hw]
        self.timer.delay_us(us)

impl Mpu6050
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Mpu6050
        Mpu6050 { bus: bus, pins: pins, timer: BoardTimer { id: 0 }, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The gyroscope's setter for the rate, and the sample rate in
    // thousandths of a hertz.
    fn gyro_set_rate_hz(self, hz: Int) -> Int [hw]
        gyro_rate_hz_write(self, hz)

    fn rate_mhz(self) -> Int [hw]
        rate_read(self)

    fn set_rate_mhz(self, mhz: Int) -> Int [hw]
        rate_write(self, mhz)

    // The digital low-pass filter.
    fn dlpf(self) -> Int [hw]
        dlpf_read(self)

    fn set_dlpf(self, cfg: Int) -> Bool [hw]
        dlpf_write(self, cfg)

    // The power state, the wake-up rate of the cycle mode, the clock source
    // and the temperature sensor.
    fn mode(self) -> Mpu6050Mode [hw]
        mode_read(self)

    fn set_mode(self, m: Mpu6050Mode) -> Bool [hw]
        mode_write(self, m)

    fn set_wake_rate(self, ctrl: Int) -> Bool [hw]
        wake_write(self, ctrl)

    fn set_clock(self, sel: Int) -> Bool [hw]
        clock_write(self, sel)

    fn set_temp_enabled(self, on: Bool) -> Bool [hw]
        temp_enable(self, on)

    // The interrupt pin, and INT_STATUS.
    fn route_int(self, mask: Int) -> Bool [hw]
        int_route(self, mask)

    fn configure_pin(self, active_low: Bool, open_drain: Bool) -> Bool [hw]
        int_pin_config(self, active_low, open_drain)

    fn status(self) -> ?Int [hw]
        int_status(self)

    // The FIFO: on, off, and both sensors' samples.
    fn fifo_begin(self, with_gyro: Bool) -> Bool [hw]
        fifo_start(self, with_gyro)

    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    fn fifo_take_imu(self, var accel: Vec[AccelMilliG; 32],
                     var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
        fifo_read_imu(self, var accel, var gyro)

    // The self-tests and the factory trims they are compared with.
    fn accel_test(self) -> ?AccelMilliG [hw]
        accel_self_test(self)

    fn gyro_test(self) -> ?GyroMilliDps [hw]
        gyro_self_test(self)

    fn accel_trim(self) -> ?AccelMilliG [hw]
        accel_trim_read(self)

    fn gyro_trim(self) -> ?GyroMilliDps [hw]
        gyro_trim_read(self)

impl Accelerometer[hw] for Mpu6050
    fn accel_read(self) -> ?AccelMilliG [hw]
        accel_read_of(self)

    // The one data-ready flag, which clears when it is read.
    fn accel_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn accel_range(self) -> AccelRange [hw]
        accel_range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        accel_range_write(self, r)

    // The sample rate in whole hertz, to the nearest; 0 when the
    // accelerometer is in standby.
    fn accel_rate_hz(self) -> Int [hw]
        accel_rate_hz_read(self)

    // Sets the sample rate of both sensors; 0 puts the accelerometer in
    // standby.
    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        accel_rate_hz_write(self, hz)

    // Samples in the FIFO, of both sensors when the gyroscope is batched.
    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

impl Gyroscope[hw] for Mpu6050
    fn gyro_read(self) -> ?GyroMilliDps [hw]
        gyro_read_of(self)

    // The one data-ready flag, which clears when it is read.
    fn gyro_ready(self) -> Bool [hw]
        data_ready_of(self)

    fn gyro_range(self) -> GyroRange [hw]
        gyro_range_read(self)

    fn gyro_set_range(self, r: GyroRange) -> Bool [hw]
        gyro_range_write(self, r)

    fn gyro_rate_hz(self) -> Int [hw]
        gyro_rate_hz_read(self)

impl Imu[hw] for Mpu6050
    fn imu_read(self) -> ?ImuSample [hw]
        imu_read_of(self)

impl Thermometer[hw] for Mpu6050
    // The sensor converts by itself while the part runs, so nothing is
    // started and no time is needed.
    fn temp_start(self) -> Int [hw]
        0

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Mpu6050
    // WHO_AM_I, 0x68; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

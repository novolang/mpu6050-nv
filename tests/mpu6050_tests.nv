    test.assert(mpu6050.int_pin_config(d, true, false))
    test.assert_eq(reg_of(c, 0x37), 0xB2)
    test.assert(mpu6050.int_pin_config(d, false, true))
    test.assert_eq(reg_of(c, 0x37), 0x72)
    test.assert(mpu6050.int_pin_config(d, true, true))
    test.assert_eq(reg_of(c, 0x37), 0xF2)

